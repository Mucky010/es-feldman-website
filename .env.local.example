# Required env vars for this project:
# POSTGRES_URL - Vercel Postgres / Neon connection string
# BLOB_READ_WRITE_TOKEN - Vercel Blob token
# ADMIN_PASSWORD_HASH - bcrypt hash of admin password (generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))")
# SESSION_SECRET - at least 32 char random string for cookie encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
